# Copy to .env and fill values. Never commit the real token.
DISCORD_TOKEN=

# Backward compatible primary guild. Existing channel/role env defaults apply only here.
GUILD_ID=
# Additional guilds, comma-separated. You may also include the primary guild; duplicates are removed.
GUILD_IDS=

# Legacy defaults for GUILD_ID only (new guilds use setup commands / SQLite guild_config)
DEFAULT_CHANNEL_ID=
DEF_ROLE_ID=
ALERT_CHANNEL_ID=

# Optional
PANEL_TITLE=Ping DEF
COOLDOWN_SECONDS=30

# Legacy admin roles for GUILD_ID only (comma-separated)
ADMIN_ROLE_IDS=

# Legacy scoreboard defaults for GUILD_ID only
GUILDEUX_ROLE_ID=
SCOREBOARD_CHANNEL_ID=
SCOREBOARD_TOP_N=25

# Optional data/test overrides
# DB_PATH=
# DRAGODINDE_DATA_DIR=
# METIERS_DATA_DIR=

# Logging / monitoring
LOG_LEVEL=info
LOG_TO_FILE=true
LOG_DIR=logs
HEARTBEAT_INTERVAL_SECONDS=300
